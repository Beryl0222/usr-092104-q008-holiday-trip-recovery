{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "假期联程保障协商领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "SEGMENT_CONFIRMED",
        "DISRUPTION_RECEIVED",
        "OPTION_PROPOSED",
        "CHOICE_ACCEPTED",
        "FUNDS_RECONCILED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "travel_party",
        "booking_segment",
        "recovery_option",
        "financial_resolution"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
